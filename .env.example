# --- Supabase ---
# Público (pode ficar exposto no navegador)
NEXT_PUBLIC_SUPABASE_URL=https://ebqvtoqpoxaklhheaeve.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_Bl5CIfdk2CIstEc78-P0-Q_MvwIYYUC

# Secreta — NUNCA exponha no cliente. Pegue em:
# Supabase > Project Settings > API > service_role key
# É obrigatória: todas as ações administrativas (aprovar cadastro, validar
# registro, alterar senha, etc.) rodam no servidor com esta chave, porque as
# tabelas ficam com RLS fechado para o público (anon).
SUPABASE_SERVICE_ROLE_KEY=

# --- Sessão de login ---
# Qualquer string longa e aleatória (ex.: gere com `openssl rand -hex 32`).
# Usada para assinar o cookie de sessão do login por CPF/senha.
SESSION_SECRET=troque-por-uma-string-longa-e-aleatoria

# --- E-mail (Gmail SMTP) ---
# Usado para notificar o Desenvolvedor da Plataforma quando uma nova igreja
# se cadastra. Gere uma "Senha de app" em myaccount.google.com/apppasswords
# (exige verificação em 2 etapas ativada na conta alzemirocha@gmail.com).
GMAIL_USER=alzemirocha@gmail.com
GMAIL_APP_PASSWORD=

# --- Seed inicial (opcional, só usado por `npm run seed`) ---
# Senha inicial da conta do Desenvolvedor (login por e-mail, Aba 2).
DEV_ADMIN_SEED_PASSWORD=trocar123
# PIN inicial da conta do CPF do desenvolvedor (login por CPF, Aba 1 —
# entra como Secretário da Igreja Sucupira, sem financeiro).
DEV_CPF_SEED_PASSWORD=0000
